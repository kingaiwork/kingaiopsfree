{
  "schema": "kingai.project.v1",
  "product_id": "kingai-ops-public-distribution",
  "name": "KINGAI OPS Public Distribution",
  "role": "public-binary-distribution",
  "visibility": "public",
  "deployment": {
    "production_authority": false,
    "production_domains": [],
    "distribution_channel": "signed-binary-and-installer"
  },
  "platform": {
    "runtime_source": "kingaiwork/kingai-ops",
    "web_authority": "kingaiwork/KINGAIASE:apps/ops-web",
    "api_origin": "https://api.kingai.work",
    "identity_mode": "federated-client",
    "direct_core_data_access": false,
    "direct_ai_provider_access": false,
    "cloud_identity_authority": false,
    "cloud_billing_authority": false
  },
  "brand_source": "kingaiwork/KINGAIASE:brand/kingai-mark.svg",
  "governance_source": "kingaiwork/KINGAIASE",
  "rules": [
    "May publish verified installer and signed binary release artifacts",
    "Must not become a second OPS web/control-plane implementation",
    "No production secrets or Cloudflare authority"
  ]
}
